{
  "name": "api",
  "version": "2.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "node scripts/prisma.js generate",
    "db:migrate": "node scripts/prisma.js migrate deploy",
    "db:status": "node scripts/prisma.js migrate status",
    "db:migrate:offline": "node scripts/migrate-offline.js",
    "demo:seed": "node scripts/demo-seed.js",
    "demo:scenario": "node scripts/demo-seed.js --full",
    "hindsight:check": "node scripts/hindsight-check.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@vectorize-io/hindsight-client": "0.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "prisma": "6.19.3"
  }
}

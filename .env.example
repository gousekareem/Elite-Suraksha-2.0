# ─── EliteSuraksha 2.0 — environment variables ────────────────────────────────
# Copy to .env (repo root) and fill in. Placeholders only — never commit real values.

# ── APPLICATION ──
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server proxies /api, so this is only
# needed if you serve the web app from another origin).
CORS_ORIGIN=http://localhost:5173
# Judge Demo controls + one-click demo login. Defaults to true outside production. Keep false in production.
DEMO_MODE_ENABLED=true
# Show the OTP in API responses (development convenience). Defaults to true outside production.
EXPOSE_DEV_OTP=true

# ── DATABASE (PostgreSQL 14+) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elite_suraksha
# Used by `npm test` (integration tests DROP and recreate this database's public schema).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elite_suraksha_test

# ── AUTH ──
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

# ── HINDSIGHT (persistent agent memory) ──
HINDSIGHT_ENABLED=true
# Local server (docker/pip) or Hindsight Cloud endpoint
HINDSIGHT_URL=http://localhost:8888
# Only needed for authenticated deployments (e.g. Hindsight Cloud)
HINDSIGHT_API_KEY=
# One bank per worker: <prefix><workerProfileId>
HINDSIGHT_BANK_PREFIX=elitesuraksha-worker-
# low | mid | high
HINDSIGHT_RECALL_BUDGET=mid
# verbatim (default: store our code-computed memory text as-is) | concise (Hindsight LLM extracts facts)
HINDSIGHT_RETAIN_EXTRACTION_MODE=verbatim
HINDSIGHT_RECALL_TIMEOUT_MS=20000
HINDSIGHT_RETAIN_TIMEOUT_MS=120000
# Print [HINDSIGHT] RETAIN / RECALL lines to the API log
HINDSIGHT_LOG_OPERATIONS=true

# ── LLM (optional interpretation layer; facts are always computed by code) ──
# none | anthropic | openai  (openai = any OpenAI-compatible Chat Completions endpoint)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional custom endpoint, e.g. https://api.openai.com/v1 or a compatible gateway
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000
LLM_MAX_TOOL_ROUNDS=8

# ── WEB (Vite) ──
# Leave empty to use same-origin /api/v1 through the Vite proxy.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api (default http://localhost:4000)
VITE_API_PROXY_TARGET=http://localhost:4000

# ── MOBILE (Expo companion) ──
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
